# wp-edu-sso.php
msgid "Invalid SSO connection. Please update your student plugin and generate a new connection from your dashboard."
msgstr "Geçersiz SSO bağlantısı. Lütfen öğrenci eklentinizi güncelleyin ve panonuzdan yeni bir bağlantı oluşturun."

msgid "Security Error"
msgstr "Güvenlik Hatası"

msgid "This secure login link has expired (24 hours). Please return to your student dashboard and click the button again."
msgstr "Bu güvenli giriş bağlantısının süresi (24 saat) dolmuş. Lütfen öğrenci panelinize dönüp butona tekrar tıklayın."

msgid "SSO Timeout"
msgstr "SSO Zaman Aşımı"

msgid "SSO security verification failed. The link has been tampered with."
msgstr "SSO güvenlik doğrulaması başarısız. Bağlantı tahrif edilmiş."

msgid "Security Violation"
msgstr "Güvenlik İhlali"

msgid "Invalid or expired SSO session key."
msgstr "Geçersiz veya süresi dolmuş SSO oturum anahtarı."

msgid "SSO Error"
msgstr "SSO Hata"

msgid "No user found on the Host site corresponding to this email address."
msgstr "Host sitesinde bu e-posta adresine karşılık gelen bir kullanıcı bulunamadı."

msgid "User Not Found"
msgstr "Kullanıcı Bulunamadı"

